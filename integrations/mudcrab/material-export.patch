diff --git a/crates/converter/src/research.rs b/crates/converter/src/research.rs
new file mode 100644
index 0000000..c9845b6
--- /dev/null
+++ b/crates/converter/src/research.rs
@@ -0,0 +1,161 @@
+//! Read-only bounded material inspection. Decoded input is distinct from converter interpretation.
+use crate::{
+    cache,
+    mesh::{MeshConverter, parse_skyrim_header},
+};
+use color_eyre::{Result, eyre::ensure};
+use project_wormhole_nif::{bs::prelude::BSShaderTextureSet, nif_block::NifBlock};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::{
+    panic::{AssertUnwindSafe, catch_unwind},
+    path::Path,
+};
+pub const MAX_INPUT_BYTES: u64 = 128 * 1024 * 1024;
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RawBlock {
+    pub block: u32,
+    pub block_type: String,
+    pub status: String,
+    pub fields: Value,
+    pub block_byte_start: u64,
+    pub block_byte_end: u64,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct MaterialInspection {
+    pub schema_version: u32,
+    pub asset_sha256: String,
+    pub header: Value,
+    pub raw_blocks: Vec<RawBlock>,
+    pub interpreted: Value,
+    pub diagnostics: Vec<Value>,
+}
+/// Inspect only selected bytes; never convert, repair or modify the input.
+pub fn inspect_materials(path: &Path) -> Result<MaterialInspection> {
+    ensure!(
+        std::fs::metadata(path)?.len() <= MAX_INPUT_BYTES,
+        "research NIF exceeds 128 MiB"
+    );
+    let bytes = std::fs::read(path)?;
+    let (mut data, header) = parse_skyrim_header(&bytes, path)?;
+    ensure!(header.block_count <= 65536, "research block limit exceeded");
+    let mut raw_blocks = vec![];
+    let mut diagnostics = vec![];
+    for index in 0..header.block_count as usize {
+        let size = header.block_size_index[index] as usize;
+        ensure!(size <= data.len(), "truncated selected NIF block");
+        let start = bytes.len() - data.len();
+        let (raw, rest) = data.split_at(size);
+        data = rest;
+        let block_type = header
+            .get_block_type(index)
+            .map_err(|_| color_eyre::eyre::eyre!("invalid block type"))?
+            .to_owned();
+        if !matches!(
+            block_type.as_str(),
+            "BSTriShape"
+                | "NiTriShape"
+                | "BSDynamicTriShape"
+                | "BSSubIndexTriShape"
+                | "BSLODTriShape"
+                | "BSLightingShaderProperty"
+                | "BSEffectShaderProperty"
+                | "BSShaderTextureSet"
+                | "NiAlphaProperty"
+        ) {
+            continue;
+        }
+        let parsed = catch_unwind(AssertUnwindSafe(|| {
+            NifBlock::parse(raw, block_type.clone())
+        }));
+        let mut status = "decoded";
+        let fields = match parsed {
+            Ok(Ok((_, block))) => match block {
+                NifBlock::BSLightingShaderProperty(p) => {
+                    json!({"shader_type":p.shader_type,"shader_flags_1":p.shader_flags_1.raw(),"shader_flags_2":p.shader_flags_2.raw(),"texture_set":p.texture_set,"alpha":f32_value(p.alpha),"glossiness":f32_value(p.glossiness),"specular_strength":f32_value(p.specular_strength),"specular_color":p.specular_color.0.to_array().map(f32_value),"emissive_color":p.emissive_color.0.to_array().map(f32_value),"emissive_multiple":f32_value(p.emissive_multiple),"uv_offset":p.uv_offset.0.to_array().map(f32_value),"uv_scale":p.uv_scale.0.to_array().map(f32_value)})
+                }
+                NifBlock::BSEffectShaderProperty(p) => {
+                    json!({"shader_flags_1":p.shader_flags_1.raw(),"shader_flags_2":p.shader_flags_2.raw(),"source_texture":p.source_texture.0,"greyscale_texture":p.greyscale_texture.0,"base_color":p.base_color.0.to_array().map(f32_value),"base_color_scale":f32_value(p.base_color_scale)})
+                }
+                NifBlock::BSShaderTextureSet(_) => match BSShaderTextureSet::parse_with_raw(raw) {
+                    Ok((_, (_, strings))) => json!({"textures":strings}),
+                    Err(_) => {
+                        status = "unresolved";
+                        json!({})
+                    }
+                },
+                NifBlock::BSTriShape(s) => {
+                    shape_fields(s.shader_property, s.alpha_property, s.av.object.name)
+                }
+                NifBlock::BSDynamicTriShape(s) => shape_fields(
+                    s.bs_tri_shape.shader_property,
+                    s.bs_tri_shape.alpha_property,
+                    s.bs_tri_shape.av.object.name,
+                ),
+                NifBlock::BSSubIndexTriShape(s) => shape_fields(
+                    s.bs_tri_shape.shader_property,
+                    s.bs_tri_shape.alpha_property,
+                    s.bs_tri_shape.av.object.name,
+                ),
+                NifBlock::BSLODTriShape(s) => shape_fields(
+                    s.bs_tri_shape.shader_property,
+                    s.bs_tri_shape.alpha_property,
+                    s.bs_tri_shape.av.object.name,
+                ),
+                NifBlock::NiTriShape(s) => {
+                    shape_fields(s.shader_property, s.alpha_property, s.name)
+                }
+                NifBlock::NiAlphaProperty(p) => {
+                    json!({"flags":p.flags.raw(),"threshold":p.threshold})
+                }
+                _ => {
+                    status = "unresolved";
+                    json!({})
+                }
+            },
+            _ => {
+                status = "unresolved";
+                json!({})
+            }
+        };
+        if status != "decoded" {
+            diagnostics.push(json!({"code":"RAW_BLOCK_UNAVAILABLE","block":index,"block_type":block_type,"detail":"decoder did not recover authored fields; no fallback values exported"}));
+        }
+        raw_blocks.push(RawBlock {
+            block: index as u32,
+            block_type,
+            status: status.into(),
+            fields,
+            block_byte_start: start as u64,
+            block_byte_end: (start + size) as u64,
+        });
+    }
+    let interpreted = tag_f32(serde_json::to_value(MeshConverter::inspect_nif_materials(
+        path,
+    )?)?);
+    Ok(MaterialInspection {
+        schema_version: 1,
+        asset_sha256: cache::hash_bytes(&bytes),
+        header: json!({"nif_version":format!("{:?}",header.nif_version),"user_version":header.user_version,"bethesda_version":header.bethesda_version,"block_count":header.block_count}),
+        raw_blocks,
+        interpreted,
+        diagnostics,
+    })
+}
+fn shape_fields(shader: u32, alpha: u32, name: u32) -> Value {
+    json!({"shader_property":shader,"alpha_property":alpha,"name_index":name})
+}
+/// Retain exact IEEE 754 f32 values, including nonfinite authored values.
+pub fn f32_value(value: f32) -> Value {
+    json!({"type":"f32","bits":format!("0x{:08x}",value.to_bits()),"display":value.to_string()})
+}
+fn tag_f32(v: Value) -> Value {
+    match v {
+        Value::Number(ref n) if n.is_f64() => f32_value(n.as_f64().expect("float") as f32),
+        Value::Array(a) => Value::Array(a.into_iter().map(tag_f32).collect()),
+        Value::Object(o) => Value::Object(o.into_iter().map(|(k, v)| (k, tag_f32(v))).collect()),
+        v => v,
+    }
+}
diff --git a/crates/converter/tests/kg_materials.rs b/crates/converter/tests/kg_materials.rs
new file mode 100644
index 0000000..452312d
--- /dev/null
+++ b/crates/converter/tests/kg_materials.rs
@@ -0,0 +1,130 @@
+//! Actual parser/converter extraction tests; normalized JSON fixtures are not proof here.
+use converter::{mesh::MeshConverter, research};
+use dummy_content::nif::{self, ResearchMaterial, StaticShape};
+use serde_json::Value;
+fn fixture() -> Vec<u8> {
+    let positions = [[-1., -1., 0.], [1., -1., 0.], [0., 1., 0.]];
+    let normals = [[0., 0., 1.]; 3];
+    let uvs = [[0., 0.], [1., 0.], [0.5, 1.]];
+    let indices = [[0, 1, 2]];
+    let shape = StaticShape {
+        name: "duplicate",
+        positions: &positions,
+        normals: &normals,
+        uvs: &uvs,
+        indices: &indices,
+        diffuse: "textures/shared.dds",
+        normal_texture: "textures/shared.dds",
+    };
+    nif::research_material_shapes(&[
+        ResearchMaterial {
+            shape: shape.clone(),
+            shader_flags_2: 16,
+            glossiness: 150.,
+            emissive_multiple: -1.,
+        },
+        ResearchMaterial {
+            shape,
+            shader_flags_2: 0,
+            glossiness: 80.,
+            emissive_multiple: 1.,
+        },
+    ])
+    .unwrap()
+}
+fn glb_json(bytes: &[u8]) -> Value {
+    let size = u32::from_le_bytes(bytes[12..16].try_into().unwrap()) as usize;
+    serde_json::from_slice(&bytes[20..20 + size]).unwrap()
+}
+#[test]
+fn real_nif_material_roundtrip() {
+    let dir = tempfile::tempdir().unwrap();
+    let nif = dir.path().join("input.nif");
+    let glb = dir.path().join("meshes/output.glb");
+    std::fs::write(&nif, fixture()).unwrap();
+    let before = std::fs::read(&nif).unwrap();
+    let report = research::inspect_materials(&nif).unwrap();
+    assert_eq!(report.interpreted.as_array().unwrap().len(), 2);
+    let raw = report.raw_blocks.iter().find(|b| b.block == 2).unwrap();
+    assert_eq!(raw.fields["shader_flags_2"], 16);
+    assert_eq!(raw.fields["emissive_multiple"]["bits"], "0xbf800000");
+    assert_eq!(
+        report.interpreted[0]["disposition"]["material"]["emissive_multiple"]["bits"],
+        "0x00000000"
+    );
+    MeshConverter::convert_nif_to_glb(&nif, &glb).unwrap();
+    let published = std::fs::read(&glb).unwrap();
+    let json = glb_json(&published);
+    let materials = json["materials"].as_array().unwrap();
+    assert_eq!(materials.len(), 2);
+    assert!(materials.iter().any(|m| m["doubleSided"] == true));
+    assert!(materials.iter().any(|m| m.get("doubleSided").is_none()));
+    let blocks = materials
+        .iter()
+        .map(|m| {
+            m.pointer("/extras/openSkyrim/shapeBlock")
+                .unwrap()
+                .as_u64()
+                .unwrap()
+        })
+        .collect::<std::collections::BTreeSet<_>>();
+    assert_eq!(blocks, std::collections::BTreeSet::from([1, 4]));
+    assert!(
+        json["images"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .any(|i| i["uri"].as_str().unwrap().contains("opensky-srgb"))
+    );
+    assert!(
+        json["images"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .any(|i| !i["uri"].as_str().unwrap().contains("opensky-srgb"))
+    );
+    let after = research::inspect_materials(&nif).unwrap();
+    assert_eq!(report.asset_sha256, after.asset_sha256);
+    MeshConverter::convert_nif_to_glb(&nif, &glb).unwrap();
+    assert_eq!(std::fs::read(&glb).unwrap(), published);
+    assert_eq!(std::fs::read(&nif).unwrap(), before);
+}
+#[test]
+fn fallback_is_not_raw() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("input.nif");
+    let bytes = fixture();
+    std::fs::write(&path, &bytes).unwrap();
+    let report = research::inspect_materials(&path).unwrap();
+    assert!(report.raw_blocks.iter().all(|b| b.status == "decoded"));
+    let shader = report.raw_blocks.iter().find(|b| b.block == 2).unwrap();
+    let mut broken = bytes;
+    let start = shader.block_byte_start as usize;
+    let end = shader.block_byte_end as usize;
+    broken[start..end].fill(0xff);
+    std::fs::write(&path, broken).unwrap();
+    match research::inspect_materials(&path) {
+        Ok(report) => {
+            let raw = report.raw_blocks.iter().find(|b| b.block == 2).unwrap();
+            if raw.status != "decoded" {
+                assert_eq!(raw.fields, serde_json::json!({}));
+            } else {
+                assert_eq!(raw.fields["shader_flags_2"], u32::MAX);
+            }
+        }
+        Err(_) => { /* Invalid authored material is an extraction failure, not an empty success. */
+        }
+    }
+}
+#[test]
+fn parser_retains_original_texture_spelling() {
+    use project_wormhole_nif::bs::prelude::BSShaderTextureSet;
+    let original = "Textures\\Shared.DDS";
+    let mut raw = vec![];
+    raw.extend_from_slice(&1u32.to_le_bytes());
+    raw.extend_from_slice(&(original.len() as u32).to_le_bytes());
+    raw.extend_from_slice(original.as_bytes());
+    let (_, (parsed, spelling)) = BSShaderTextureSet::parse_with_raw(&raw).unwrap();
+    assert_eq!(spelling, [original]);
+    assert_ne!(parsed.textures[0].as_deref(), Some(original));
+}
