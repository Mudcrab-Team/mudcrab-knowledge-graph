diff --git a/crates/converter/src/bin/kg-export.rs b/crates/converter/src/bin/kg-export.rs
new file mode 100644
index 0000000..2f0d835
--- /dev/null
+++ b/crates/converter/src/bin/kg-export.rs
@@ -0,0 +1,190 @@
+//! Explicitly selected read-only material research export; never runs conversion.
+use clap::Parser;
+use color_eyre::{Result, eyre::ensure};
+use converter::{cache, research};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::{
+    fs,
+    path::{Path, PathBuf},
+};
+#[derive(Parser)]
+#[command(about = "Read-only selected NIF/GLB research export")]
+struct Args {
+    #[arg(long)]
+    input_root: PathBuf,
+    #[arg(long)]
+    converted_root: Option<PathBuf>,
+    #[arg(long)]
+    selection: PathBuf,
+    #[arg(long)]
+    out: PathBuf,
+    #[arg(long)]
+    converter_revision: Option<String>,
+    #[arg(long)]
+    synthetic: bool,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Selection {
+    schema_version: u32,
+    inputs: Vec<Input>,
+    #[serde(default)]
+    manifest: Option<String>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Input {
+    nif: String,
+    #[serde(default)]
+    glb: Option<String>,
+}
+fn main() {
+    if let Err(e) = run(Args::parse()) {
+        eprintln!("{e}");
+        std::process::exit(5);
+    }
+}
+fn run(args: Args) -> Result<()> {
+    ensure!(
+        fs::metadata(&args.selection)?.len() <= 1024 * 1024,
+        "selection exceeds limit"
+    );
+    let selection: Selection = serde_json::from_slice(&fs::read(&args.selection)?)?;
+    ensure!(
+        selection.schema_version == 1
+            && !selection.inputs.is_empty()
+            && selection.inputs.len() <= 256,
+        "select 1–256 inputs"
+    );
+    ensure!(!args.out.exists(), "output destination must be new");
+    let parent = args.out.parent().unwrap_or(Path::new("."));
+    fs::create_dir_all(parent)?;
+    let out_parent = parent.canonicalize()?;
+    let input_root = args.input_root.canonicalize()?;
+    let converted_root = args
+        .converted_root
+        .as_deref()
+        .unwrap_or(&args.input_root)
+        .canonicalize()?;
+    ensure!(
+        !out_parent.starts_with(&input_root) && !out_parent.starts_with(&converted_root),
+        "research output must be outside read-only inputs"
+    );
+    if let Some(revision) = &args.converter_revision {
+        ensure!(
+            revision.len() == 40 && revision.bytes().all(|c| c.is_ascii_hexdigit()),
+            "converter revision must be a full commit"
+        );
+    }
+    let staging = parent.join(format!(".kg-export-{}", std::process::id()));
+    ensure!(
+        !staging.exists(),
+        "research staging destination already exists"
+    );
+    fs::create_dir(&staging)?;
+    let result = (|| -> Result<Value> {
+        let mut inputs = vec![];
+        let mut seen = std::collections::BTreeSet::new();
+        for input in selection.inputs {
+            ensure!(seen.insert(input.nif.clone()), "duplicate selected NIF");
+            let nif = safe(&input_root, &input.nif)?;
+            ensure!(
+                fs::metadata(&nif)?.len() <= research::MAX_INPUT_BYTES,
+                "NIF exceeds limit"
+            );
+            let raw = fs::read(&nif)?;
+            let inspection = research::inspect_materials(&nif)?;
+            let nif_artifact = format!("input/{}", input.nif);
+            copy_bytes(&staging, &nif_artifact, &raw)?;
+            let glb = if let Some(name) = input.glb {
+                let path = safe(&converted_root, &name)?;
+                ensure!(
+                    fs::metadata(&path)?.len() <= research::MAX_INPUT_BYTES,
+                    "GLB exceeds limit"
+                );
+                let raw = fs::read(&path)?;
+                let artifact = format!("output/{name}");
+                copy_bytes(&staging, &artifact, &raw)?;
+                Some(
+                    json!({"path":artifact,"output_path":name,"sha256":cache::hash_bytes(&raw),"byte_size":raw.len()}),
+                )
+            } else {
+                None
+            };
+            ensure!(
+                cache::hash_file(&nif)? == inspection.asset_sha256,
+                "NIF changed during read-only export"
+            );
+            inputs.push(json!({"nif":{"path":nif_artifact,"sha256":cache::hash_bytes(&raw),"byte_size":raw.len()},"inspection":inspection,"glb":glb}));
+        }
+        let manifest = if let Some(name) = selection.manifest {
+            let path = safe(&converted_root, &name)?;
+            ensure!(
+                fs::metadata(&path)?.len() <= 8 * 1024 * 1024,
+                "manifest exceeds limit"
+            );
+            let bytes = fs::read(path)?;
+            let data: Value = serde_json::from_slice(&bytes)?;
+            let artifact = format!("manifest/{name}");
+            copy_bytes(&staging, &artifact, &bytes)?;
+            Some(json!({"path":artifact,"sha256":cache::hash_bytes(&bytes),"data":data}))
+        } else {
+            None
+        };
+        Ok(
+            json!({"format":"mudcrab-material-inspection","schema_version":1,"exporter":{"name":"kg-export","version":env!("CARGO_PKG_VERSION")},"converter_revision":args.converter_revision,"converter_revision_origin":if args.converter_revision.is_some(){"operator_supplied"}else{"unknown"},"synthetic":args.synthetic,"visibility":if args.synthetic{"public"}else{"restricted"},"inputs":inputs,"manifest":manifest}),
+        )
+    })();
+    match result {
+        Ok(report) => {
+            fs::write(
+                staging.join("inspection.json"),
+                serde_json::to_vec_pretty(&report)?,
+            )?;
+            ensure!(
+                !args.out.exists(),
+                "output destination appeared during export"
+            );
+            fs::rename(&staging, &args.out)?;
+            println!(
+                "{}",
+                json!({"format":"mudcrab-material-inspection","inputs":report["inputs"].as_array().map_or(0,Vec::len),"status":"exported"})
+            );
+            Ok(())
+        }
+        Err(e) => {
+            let _ = fs::remove_dir_all(staging);
+            Err(e)
+        }
+    }
+}
+fn safe(root: &Path, name: &str) -> Result<PathBuf> {
+    ensure!(
+        !name.is_empty()
+            && !name.starts_with('/')
+            && !name.contains(['\\', ':', '\0'])
+            && name
+                .split('/')
+                .all(|s| !s.is_empty() && s != ".." && s != "."),
+        "noncanonical selected input path"
+    );
+    let mut path = root.to_owned();
+    for component in name.split('/') {
+        path.push(component);
+        ensure!(
+            !fs::symlink_metadata(&path)?.file_type().is_symlink(),
+            "symlink selected input is forbidden"
+        );
+    }
+    ensure!(path.is_file(), "selected input is not an ordinary file");
+    Ok(path)
+}
+fn copy_bytes(staging: &Path, path: &str, bytes: &[u8]) -> Result<()> {
+    let dest = staging.join("artifacts").join(path);
+    if let Some(p) = dest.parent() {
+        fs::create_dir_all(p)?;
+    }
+    fs::write(dest, bytes)?;
+    Ok(())
+}
