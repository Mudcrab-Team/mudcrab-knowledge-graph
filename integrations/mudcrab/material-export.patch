+//! Generate original two-shape research input for the real converter pipeline.
+use color_eyre::{Result, eyre::ensure};
+use dummy_content::{layout, nif};
+use std::path::PathBuf;
+fn main() -> Result<()> {
+    let path = std::env::args().nth(1).map(PathBuf::from).ok_or_else(|| {
+        color_eyre::eyre::eyre!("usage: kg_material_fixture <new-Data-directory>")
+    })?;
+    ensure!(!path.exists(), "fixture destination must be new");
+    std::fs::create_dir_all(&path)?;
+    layout::generate(
+        &path,
+        layout::DEFAULT_SEED,
+        layout::Formats {
+            dds: true,
+            pex: false,
+            nif: false,
+            bsa: false,
+            ba2: false,
+            esm: true,
+        },
+    )?;
+    let positions = [[-1., -1., 0.], [1., -1., 0.], [0., 1., 0.]];
+    let normals = [[0., 0., 1.]; 3];
+    let uvs = [[0., 0.], [1., 0.], [0.5, 1.]];
+    let indices = [[0, 1, 2]];
+    let shape = nif::StaticShape {
+        name: "duplicate",
+        positions: &positions,
+        normals: &normals,
+        uvs: &uvs,
+        indices: &indices,
+        diffuse: layout::GENERATED_DIFFUSE_PATH,
+        normal_texture: layout::GENERATED_DIFFUSE_PATH,
+    };
+    let second = nif::StaticShape {
+        normal_texture: "textures/missing_research_normal.dds",
+        ..shape.clone()
+    };
+    let bytes = nif::research_material_shapes(&[
+        nif::ResearchMaterial {
+            shape,
+            shader_flags_2: 16,
+            glossiness: 150.0,
+            emissive_multiple: -1.0,
+        },
+        nif::ResearchMaterial {
+            shape: second,
