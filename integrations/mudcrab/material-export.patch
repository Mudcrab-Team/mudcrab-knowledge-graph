+/// Material values used only by original procedural research fixtures.
+#[derive(Debug, Clone)]
+pub struct ResearchMaterial<'a> {
+    /// Shape geometry and texture paths.
+    pub shape: StaticShape<'a>,
+    /// Original shader flag bitfield.
+    pub shader_flags_2: u32,
+    /// Original glossiness, before converter publication.
+    pub glossiness: f32,
+    /// Original emissive multiplier, including the static clamp case.
+    pub emissive_multiple: f32,
+}
+
+/// Generate up to 64 original shapes with distinct block identities and duplicate names.
+/// Uses the same serializer as `static_shape`; this does not change its fixture output.
+pub fn research_material_shapes(shapes: &[ResearchMaterial<'_>]) -> Result<Vec<u8>> {
+    ensure!(
+        !shapes.is_empty() && shapes.len() <= 64,
+        "select 1–64 research shapes"
+    );
+    for shape in shapes {
+        validate(&shape.shape)?;
+        ensure!(
+            shape.glossiness.is_finite() && shape.emissive_multiple.is_finite(),
+            "fixture values must be finite"
+        );
+    }
+    let mut root = Vec::new();
+    push_av_object(&mut root, NULL_REF);
+    push_u32(&mut root, shapes.len() as u32);
+    for i in 0..shapes.len() {
+        push_u32(&mut root, 1 + 3 * i as u32);
+    }
+    push_u32(&mut root, 0);
+    let mut blocks = vec![root];
+    let mut kinds = vec![0u16];
+    for (i, material) in shapes.iter().enumerate() {
+        let shape = triangle_shape_with_refs(&material.shape, i as u32, 2 + 3 * i as u32)?;
+        let shader = lighting_shader_property_with_values(
+            material.shader_flags_2,
+            material.glossiness,
+            material.emissive_multiple,
+            3 + 3 * i as u32,
+        );
+        blocks.extend([shape, shader, texture_set(&material.shape)?]);
+        kinds.extend([1, 2, 3]);
+    }
+    let types = [
+        "BSFadeNode",
+        "BSTriShape",
+        "BSLightingShaderProperty",
+        "BSShaderTextureSet",
+    ];
+    let mut bytes = Vec::new();
+    bytes.extend_from_slice(b"Gamebryo File Format, Version 20.2.0.7\n");
+    push_u32(&mut bytes, NIF_VERSION);
+    bytes.push(1);
+    push_u32(&mut bytes, USER_VERSION);
+    push_u32(&mut bytes, blocks.len() as u32);
+    push_u32(&mut bytes, BETHESDA_VERSION);
+    push_string8(&mut bytes, "OpenSkyrim original research fixture");
+    push_string8(&mut bytes, "");
+    push_string8(&mut bytes, "");
+    push_u16(&mut bytes, types.len() as u16);
+    for ty in types {
+        push_u32(&mut bytes, ty.len() as u32);
+        bytes.extend_from_slice(ty.as_bytes());
+    }
+    for kind in kinds {
+        push_u16(&mut bytes, kind);
+    }
+    for block in &blocks {
+        push_u32(&mut bytes, block.len() as u32);
+    }
+    push_u32(&mut bytes, shapes.len() as u32);
+    push_u32(
+        &mut bytes,
+        shapes
+            .iter()
+            .map(|s| s.shape.name.len() as u32)
+            .max()
+            .unwrap_or(0),
+    );
+    for shape in shapes {
+        push_u32(&mut bytes, shape.shape.name.len() as u32);
+        bytes.extend_from_slice(shape.shape.name.as_bytes());
+    }
+    push_u32(&mut bytes, 0);
+    for block in blocks {
+        bytes.extend_from_slice(&block);
+    }
+    Ok(bytes)
+}
