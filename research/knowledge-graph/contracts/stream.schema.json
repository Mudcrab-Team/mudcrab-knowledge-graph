{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mudcrab:kg:stream:1",
  "title": "Mudcrab KG streamed bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "source",
    "snapshot",
    "files"
  ],
  "properties": {
    "format": {
      "const": "mudcrab-kg-stream"
    },
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "repository",
            "binary",
            "asset_collection",
            "capture",
            "notes",
            "synthetic"
          ]
        },
        "origin_uri": {
          "type": "string"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "reviewed",
            "restricted"
          ]
        },
        "license_expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "lineage_roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "redistribution": {
          "type": "string",
          "enum": [
            "with_notice",
            "metadata_only",
            "review_required"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "origin_uri",
        "visibility",
        "license_expression",
        "lineage_roots",
        "redistribution"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^snap_[a-f0-9]{64}$"
        },
        "source_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "extraction": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "configuration_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "scope_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "tool",
            "version",
            "configuration_sha256",
            "scope_sha256"
          ],
          "additionalProperties": false
        },
        "scope": {
          "$ref": "#/$defs/value"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^snap_[a-f0-9]{64}$"
          },
          "minItems": 0
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "reviewed",
            "restricted"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "not_run",
                  "unsupported"
                ]
              },
              "detail": {
                "type": "string"
              },
              "counts": {
                "type": "object",
                "properties": {
                  "inputs_enumerated": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "inputs_attempted": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "records_emitted": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "inputs_failed": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "inputs_skipped": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "inputs_enumerated",
                  "inputs_attempted",
                  "records_emitted",
                  "inputs_failed",
                  "inputs_skipped"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "status",
              "detail",
              "counts"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "source_id",
        "revision",
        "content_sha256",
        "extraction",
        "scope",
        "dependencies",
        "visibility",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "sha256",
          "byte_size",
          "record_count"
        ],
        "properties": {
          "kind": {
            "enum": [
              "artifacts",
              "evidence",
              "nodes",
              "assertions",
              "diagnostics"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
